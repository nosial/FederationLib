# Clean up expired records every hour, does nothing if maintenance is disabled (FEDERATION_MAINTENANCE_ENABLED)
0 * * * * nice -n 10 ionice -c3 /usr/local/bin/federationlib maintenance

# Teach BayesianServer the evidence classifications it missed (eg; while it was restarting), does nothing if BayesianPlugin is not enabled
30 * * * * nice -n 10 /usr/local/bin/federationlib bayesian sync

# Apply the reputation of every completed day of activity (UTC), a day is never applied twice
15 * * * * nice -n 10 /usr/local/bin/federationlib reputation settle
